# Ryu Sushi - Environment Variables
# Copiez ce fichier en .env et remplissez les valeurs

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration (pour la production, mettez votre domaine)
CORS_ORIGIN=*

# SMTP Configuration (pour l'envoi d'emails)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=votre_utilisateur_smtp
SMTP_PASS=votre_mot_de_passe_smtp
SMTP_FROM=hello@ryusushi.com

# Email administrateur pour recevoir les réservations et contacts
ADMIN_EMAIL=ryusushi56@gmail.com

# Sécurité (optionnel - pour des fonctionnalités avancées)
# API_KEY=votre_cle_api_securisee

# Rate limiting (POST-only)
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW=60000

# SSH key for production deploy (51.15.79.169)
# Copy from ~/.ssh/tenenbaum-prod into .env
# SSH_PRIVATE_KEY='-----BEGIN OPENSSH PRIVATE KEY-----
# ...
# -----END OPENSSH PRIVATE KEY-----'
