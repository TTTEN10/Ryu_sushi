# Example Terraform variables for chatbot (PRO2-XXS) deployment.
# Copy to terraform.tfvars and fill in. Never commit terraform.tfvars with secrets.

# Scaleway (use Terraform API key — not the main app key)
scaleway_region     = "fr-par"
scaleway_zone       = "fr-par-1"
scaleway_access_key = "YOUR_TERRAFORM_ACCESS_KEY"
scaleway_secret_key = "YOUR_TERRAFORM_SECRET_KEY"
scaleway_project_id = "YOUR_PROJECT_ID"

project_name = "safepsy"
environment  = "prod"

# App host is deployed manually (Dev1-S). Chatbot is provisioned by Terraform.
ai_service_enabled = false

# Chatbot instance (POP2-2C-8G or PRO2-XXS; production uses scw-nostalgic-cannon, POP2-2C-8G)
chatbot_enabled          = true
chatbot_instance_type    = "POP2-2C-8G"
chatbot_zone             = "fr-par-2"
chatbot_root_volume_size  = 30
chatbot_container_image  = "safepsy-chatbot"
chatbot_container_image_tag = "2.0.0"
chatbot_container_env = {
  PORT                = "8000"
  USE_GPU             = "false"
  AI_INTERNAL_API_KEY = "GENERATE_WITH_openssl_rand_hex_32"
}
chatbot_ssh_key_ids = []
chatbot_allowed_ips = []

# Object storage (optional)
object_storage_bucket_names = ["chat-summaries", "logs", "backups"]
object_storage_enable_versioning = true
