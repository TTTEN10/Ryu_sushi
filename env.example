# SafePsy Landing Page Environment Configuration

# Copy this file to .env and update the values

# Frontend API URL (for the waitlist subscription endpoint)
# Leave empty to use same-origin /api
VITE_API_URL=http://localhost:3001

# Analytics (Optional)
PLAUSIBLE_DOMAIN=

# Email Configuration (for waitlist subscriptions)
ENABLE_CONFIRMATION_EMAIL=false
EMAIL_FROM_ADDRESS=noreply@safepsy.com
