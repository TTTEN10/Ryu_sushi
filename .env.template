# SafePsy Production Environment Template
#
# ⚠️ CRITICAL SECURITY INSTRUCTIONS:
# 1. NEVER commit your actual .env file to version control
# 2. Copy this to .env and fill in REAL values ONLY on secure servers
# 3. Use a secrets manager in production (1Password, AWS Secrets Manager, etc.)
# 4. Generate ALL secrets using the commands specified below
# 5. Rotate all credentials every 90 days
#
# This template contains NO real values - it's a guide for what you need.

# =============================================================================
# STEP 1: GENERATE SECURE RANDOM SECRETS (Run these commands NOW)
# =============================================================================
# Run each command and copy the output to the corresponding variable below:
#
# JWT_SECRET (32+ characters):
#   openssl rand -hex 32
#
# IP_SALT (32+ characters):
#   openssl rand -hex 32
#
# ADMIN_SECRET (32+ characters):
#   openssl rand -hex 32
#
# DID_BACKEND_SIGNER_PRIVATE_KEY (generate new wallet - DO NOT reuse exposed key):
#   cast wallet new (if you have foundry) OR use https://www.myetherwallet.com/wallet-generate
#   IMPORTANT: Store the private key in a hardware wallet or KMS, NOT in this file!
# =============================================================================

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
PORT=3001
NODE_ENV=production

# Frontend URL (update to your production domain)
FRONTEND_URL=https://polinapsycho.com

# =============================================================================
# DATABASE CONFIGURATION - CRITICAL
# =============================================================================
# STEP 2: Change your database password IMMEDIATELY
# Run this on your database:
#   ALTER USER safepsy_user WITH PASSWORD '<generate-strong-password>';
# Then update the DATABASE_URL below with the NEW password
#
# Generate strong database password:
#   openssl rand -base64 32
DATABASE_URL="postgresql://safepsy_user:CHANGE_THIS_PASSWORD_IMMEDIATELY@localhost:5432/safepsy_prod"

# =============================================================================
# JWT SESSION CONFIGURATION - CRITICAL
# =============================================================================
# STEP 3: Generate NEW JWT secret - DO NOT use the default or weak value
# Command: openssl rand -hex 32
# Output example: 3f1908c51671a74921344ea40df1144118499d01d4d7138fd2c7ac2ac0c63e64
JWT_SECRET="REPLACE_WITH_OUTPUT_OF_OPENSSL_COMMAND"
JWT_EXPIRES_IN=24h

# =============================================================================
# BLOCKCHAIN / DID CONFIGURATION - CRITICAL
# =============================================================================
# STEP 4: IMMEDIATELY transfer funds from compromised wallet
# The wallet 0x1F4739e229AdCb1c986C8A8b66f686ddEc29694c with private key
# 0x48d3642d9eb0552f3331dcc213b324a22e724adc6d5d87dec38c018816711261
# is COMPROMISED. Transfer all funds to a NEW wallet.
#
# Generate NEW wallet for backend signer:
#   cast wallet new
#   OR use https://www.myetherwallet.com/wallet-generate
#
# Store the NEW private key in AWS KMS, HashiCorp Vault, or hardware wallet
# DO NOT store it in this file in production!
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ETH_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# DID Contract Addresses (Sepolia - these are public, safe to commit)
DID_REGISTRY_ADDRESS=0x8e5F41f2B8B3E28a8966e37181B257f9E2725bA5
DID_OWNERSHIP_ADDRESS=0xac5Ad1482d73d0E09ED3960C02EebF428Ad63722
DID_IDENTITY_TOKEN_ADDRESS=0x103eAd096f898132E138ad228E35296db983A053

# Backend Signer - CRITICAL: Use NEW wallet, NOT the compromised one!
# In production, use KMS or environment injection - DO NOT hardcode here
DID_BACKEND_SIGNER_PRIVATE_KEY=REPLACE_WITH_NEWLY_GENERATED_KEY

# =============================================================================
# SCALEWAY API CONFIGURATION - CRITICAL
# =============================================================================
# STEP 5: REVOKE the exposed API key IMMEDIATELY
# Go to: https://console.scaleway.com/iam/api-keys
# Delete the key: 97b47ef8-e459-45d7-ad53-d7e9b5acb97b
#
# Create NEW API key with minimal permissions:
# - Only enable Generative API access
# - Set resource quotas
# - Enable expiration (90 days)
SCALEWAY_API_KEY=REPLACE_WITH_NEW_API_KEY
SCALEWAY_PROJECT_ID=5dad0cb7-c16a-4447-9a25-e89bd3448e8a
SCALEWAY_API_BASE_URL=https://api.scaleway.ai/${SCALEWAY_PROJECT_ID}/v1

# =============================================================================
# PRIVACY & SECURITY
# =============================================================================
# STEP 6: Generate secure IP salt
# Command: openssl rand -hex 32
IP_HASHING_ENABLED=true
IP_SALT=REPLACE_WITH_OUTPUT_OF_OPENSSL_COMMAND

# Safety middleware (these are safe defaults)
SAFETY_INJECTION_FILTER_ENABLED=true
SAFETY_INJECTION_BLOCK=true
SAFETY_MODERATION_ENABLED=true
SAFETY_MODERATION_BLOCK=false
SAFETY_PII_REDACTION_ENABLED=true
SAFETY_PII_REDACT_LOGS=true
SAFETY_PII_REDACT_RESPONSES=false

# =============================================================================
# RATE LIMITING & QUOTAS
# =============================================================================
CHAT_QUOTA_DAILY_LIMIT=100
CHAT_QUOTA_MONTHLY_LIMIT=1000

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://redis:6379/0

# =============================================================================
# ADMIN AUTHENTICATION - CRITICAL
# =============================================================================
# STEP 7: Generate secure admin secret
# Command: openssl rand -hex 32
# This protects /api/admin/* endpoints
ADMIN_SECRET=REPLACE_WITH_OUTPUT_OF_OPENSSL_COMMAND

# =============================================================================
# OPTIONAL: Email, Storage, etc.
# =============================================================================
# Add other configuration as needed (see .env.production.example)
