# Slim Dockerfile - uses pre-built frontend to reduce build size
FROM node:18-alpine AS base
RUN apk add --no-cache openssl openssl-dev postgresql-client python3 make g++ py3-pip

FROM base AS builder
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci || npm install --legacy-peer-deps || true
RUN rm -rf /root/.npm 2>/dev/null || true

COPY prisma ./prisma
RUN npx prisma generate

COPY apps/api ./apps/api
WORKDIR /app/apps/api
ENV npm_config_cache=/tmp/npm-cache
RUN npm ci || npm install --legacy-peer-deps || true
RUN rm -rf /tmp/npm-cache /root/.npm 2>/dev/null || true
RUN mkdir -p dist && cp -r src/* dist/ 2>/dev/null || true

FROM base AS runner
WORKDIR /app
COPY prisma ./prisma
RUN mkdir -p ./node_modules/.prisma ./node_modules/@prisma

# Pre-built frontend (must exist in build context)
COPY apps/web/dist ./apps/web/dist
RUN mkdir -p ./apps/api/dist ./apps/api/src
COPY --from=builder /app/apps/api/dist ./apps/api/dist/
COPY --from=builder /app/apps/api/src ./apps/api/src/
COPY --from=builder /app/apps/api/package.json ./apps/api/package.json
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/package-lock.json ./package-lock.json

WORKDIR /app
ENV npm_config_cache=/tmp/npm-cache
RUN npm install --legacy-peer-deps --only=production || true
RUN rm -rf /tmp/npm-cache /root/.npm 2>/dev/null || true
WORKDIR /app/apps/api
RUN npm install --legacy-peer-deps --only=production || true
RUN rm -rf /tmp/npm-cache /root/.npm 2>/dev/null || true
RUN cp /app/prisma/schema.prisma ./schema.prisma || true
RUN DATABASE_URL="postgresql://user:pass@localhost:5432/db" npx prisma generate || true

RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
RUN chown -R nextjs:nodejs /app
USER nextjs

EXPOSE 3000
WORKDIR /app/apps/api
CMD if [ -f "src/index.ts" ]; then npx tsx src/index.ts; elif [ -f "dist/index.js" ]; then npm start; else echo "No source or dist found"; exit 1; fi
