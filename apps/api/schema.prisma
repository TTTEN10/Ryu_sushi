generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model EmailSubscription {
  id               String    @id @default(cuid())
  email            String    @unique
  fullName         String?
  role             String?
  ipHash           String?
  consentGiven     Boolean   @default(false)
  consentTimestamp DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("email_subscriptions")
}

model ContactMessage {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  subject   String
  message   String
  ipHash    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_messages")
}

model EncryptedChat {
  id                  String    @id @default(cuid())
  walletAddress       String    @unique
  didTokenId          String?
  encryptedBlob       String
  encryptedBlobHash   String
  encryptedKey        String?
  encryptedSummaryRef String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  expiresAt           DateTime?
  retentionDays       Int?

  @@index([walletAddress])
  @@index([didTokenId])
  @@index([expiresAt])
  @@map("encrypted_chats")
}

model Subscription {
  id                  String             @id @default(cuid())
  walletAddress       String             @unique
  didTokenId          String?            @unique
  plan                SubscriptionPlan   @default(FREE)
  billingPeriod       SubscriptionBillingPeriod?
  status              SubscriptionStatus @default(ACTIVE)
  startedAt           DateTime?
  expiresAt           DateTime?
  cryptoPaymentTxHash String?            @unique
  cryptoBlockNumber   BigInt?
  paymentId           String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  payments            Payment[]

  @@index([walletAddress])
  @@index([didTokenId])
  @@index([status])
  @@index([walletAddress, status])
  @@index([expiresAt])
  @@index([cryptoPaymentTxHash])
  @@map("subscriptions")
}

model PaymentIntent {
  id            String              @id @default(cuid())
  walletAddress String
  plan          SubscriptionPlan
  billingPeriod SubscriptionBillingPeriod
  amountCents   Int
  currency      String              @default("USD")
  chainId       Int
  treasuryAddress String
  status        PaymentIntentStatus @default(PENDING)
  expiresAt     DateTime
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([walletAddress])
  @@index([status])
  @@index([walletAddress, status])
  @@map("payment_intents")
}

model Payment {
  id                  String        @id @default(cuid())
  walletAddress       String
  didTokenId          String?
  subscriptionId      String?
  paymentIntentId     String?
  plan                SubscriptionPlan
  billingPeriod       SubscriptionBillingPeriod
  amountCents         Int
  currency            String        @default("USD")
  chainId             Int
  treasuryAddress     String
  paymentMethod       PaymentMethod
  status              PaymentStatus @default(PENDING)
  cryptoTxHash        String        @unique
  cryptoBlockNumber   BigInt?
  senderAddress       String?
  tokenAddress        String?
  metadata            String?
  createdAt           DateTime      @default(now())
  confirmedAt         DateTime?
  updatedAt           DateTime      @updatedAt
  subscription        Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([walletAddress])
  @@index([status])
  @@index([cryptoTxHash])
  @@index([walletAddress, status])
  @@map("payments")
}

/**
 * PromptUsage — records every prompt request for quota accounting.
 * Each row is keyed by a unique requestId so retries are idempotent.
 */
model PromptUsage {
  id             String   @id @default(cuid())
  walletAddress  String
  requestId      String   // UUID supplied by the frontend or server
  subscriptionId String?
  timestamp      DateTime @default(now())
  metadata       String?

  @@unique([requestId])
  @@index([walletAddress, timestamp])
  @@index([subscriptionId, timestamp])
  @@map("prompt_usages")
}

model RAGAuditLog {
  id            String       @id @default(cuid())
  operation     RAGOperation
  walletAddress String?
  documentId    String?
  source        String?
  documentSize  Int?
  success       Boolean
  errorMessage  String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime     @default(now())

  @@index([operation])
  @@index([walletAddress])
  @@index([documentId])
  @@index([source])
  @@index([createdAt])
  @@map("rag_audit_logs")
}

/**
 * Crisis Safety Net - Opt-in PII storage for users who voluntarily
 * provide contact info for crisis follow-up. Auto-purged after 30 days.
 */
model CrisisOptIn {
  id                String    @id @default(cuid())
  walletAddress     String    @unique // Pseudonymous link to user (unique - one per wallet)
  email             String?   // Encrypted at rest via application layer
  fullName          String?   // Encrypted at rest via application layer
  emergencyContact  String?   // Encrypted at rest via application layer
  language          String    // Detected language code (en, zh, hi, etc.)
  consentHash       String    // Hash of consent data for audit/proof
  createdAt         DateTime  @default(now())
  expiresAt         DateTime  // Auto-purge target (created + 30 days)
  lastCrisisTrigger DateTime? // Last time crisis was detected
  triggerCount      Int       @default(0) // Number of crisis detections

  @@index([expiresAt])
  @@map("crisis_opt_in")
}

model SecurityAuditLog {
  id        String   @id @default(cuid())
  eventType String
  actor     String?
  resource  String?
  success   Boolean
  ipAddress String?
  userAgent String?
  details   String?
  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([actor])
  @@index([createdAt])
  @@map("security_audit_logs")
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  eventName  String
  visitorId  String?
  sessionId  String?
  walletHash String?
  timestamp  DateTime @default(now())
  pageUrl    String?
  referrer   String?
  userAgent  String?
  deviceType String?
  country    String?
  metadata   String?

  @@index([eventName])
  @@index([visitorId])
  @@index([timestamp])
  @@index([sessionId])
  @@index([walletHash])
  @@map("analytics_events")
}

enum SubscriptionPlan {
  FREE
  PRO
  UNLIMITED
}

enum SubscriptionBillingPeriod {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentIntentStatus {
  PENDING
  CONFIRMED
  EXPIRED
  CANCELLED
}

enum PaymentMethod {
  NONE
  STRIPE
  CRYPTO
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REJECTED
  REFUNDED
  CANCELLED
}

enum RAGOperation {
  INDEX
  DELETE
  BATCH_INDEX
}
