generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model EmailSubscription {
  id               String    @id @default(cuid())
  email            String    @unique
  fullName         String?
  role             String?
  ipHash           String?
  consentGiven     Boolean   @default(false)
  consentTimestamp DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("email_subscriptions")
}

model ContactMessage {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  subject   String
  message   String
  ipHash    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_messages")
}

model EncryptedChat {
  id                  String    @id @default(cuid())
  walletAddress       String    @unique
  encryptedBlob       String
  encryptedBlobHash   String
  didTokenId          String?
  encryptedSummaryRef String?
  encryptedKey        String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  retentionDays       Int?
  expiresAt           DateTime?

  @@index([expiresAt])
  @@map("encrypted_chats")
}

model Subscription {
  id                   String             @id @default(cuid())
  walletAddress        String             @unique
  didTokenId           String?            @unique
  tier                 SubscriptionTier   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  paymentMethod        PaymentMethod      @default(NONE)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  cryptoPaymentTxHash  String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  plan                 SubscriptionPlan?
  billingPeriod        SubscriptionBillingPeriod?
  expiresAt            DateTime?
  startedAt            DateTime?
  cryptoBlockNumber    BigInt?

  payments               Payment[]

  @@map("subscriptions")
}

model PaymentIntent {
  id               String              @id @default(cuid())
  walletAddress    String
  plan             SubscriptionPlan
  billingPeriod    SubscriptionBillingPeriod
  amountCents      Int
  currency         String              @default("USD")
  chainId          Int
  treasuryAddress  String
  selectedCurrency String
  paymentMethod    PaymentMethod       @default(NONE)
  status           PaymentIntentStatus @default(PENDING)
  expiresAt        DateTime
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  payments         Payment[]

  @@index([walletAddress, status])
  @@index([status, expiresAt])
  @@map("payment_intents")
}

model Payment {
  id               String            @id @default(cuid())
  walletAddress    String
  subscriptionId   String?
  paymentIntentId  String?
  plan             SubscriptionPlan
  billingPeriod    SubscriptionBillingPeriod
  amountCents      Int
  currency         String            @default("USD")
  chainId          Int
  treasuryAddress  String
  paymentMethod    PaymentMethod     @default(NONE)
  status           PaymentStatus     @default(PENDING)
  cryptoTxHash     String?           @unique
  cryptoBlockNumber BigInt?
  senderAddress    String?
  confirmedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  subscription     Subscription?     @relation(fields: [subscriptionId], references: [id])
  paymentIntent    PaymentIntent?    @relation(fields: [paymentIntentId], references: [id])

  @@index([walletAddress])
  @@index([cryptoTxHash])
  @@index([status])
  @@index([paymentIntentId])
  @@map("payments")
}

model PromptUsage {
  id             String   @id @default(cuid())
  walletAddress  String
  requestId      String   @unique
  subscriptionId String?
  metadata       String?
  timestamp      DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([walletAddress, timestamp])
  @@map("prompt_usages")
}

model UserConsent {
  id              String         @id @default(cuid())
  walletAddress   String
  consentType     consenttype
  consentVersion  String
  consentTextHash String
  status          consentstatus      @default(GRANTED)
  source          consentsource?
  ipAddressHash   String?
  userAgent       String?
  createdAt       DateTime       @default(now())
  withdrawnAt     DateTime?
  updatedAt       DateTime       @default(now()) @updatedAt

  @@unique([walletAddress, consentType, consentVersion], map: "user_consents_walletAddress_consentType_consentVersion")
  @@index([walletAddress, consentType])
  @@index([status])
  @@index([withdrawnAt])
  @@index([createdAt])
  @@map("user_consents")
}

model CrisisOptIn {
  id                String    @id @default(cuid())
  walletAddress     String    @unique
  email             String?
  fullName          String?
  emergencyContact  String?
  language          String?
  country           String?
  consentHash       String?
  expiresAt         DateTime?
  triggerCount      Int       @default(0)
  lastCrisisTrigger DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("crisis_opt_in")
}

model SecurityAuditLog {
  id          String   @id @default(cuid())
  walletAddress String?
  eventType   String
  actor       String?
  resource    String?
  success     Boolean
  ipAddress   String?
  userAgent   String?
  details     String?
  timestamp   DateTime @default(now())

  @@index([walletAddress, timestamp])
  @@index([timestamp])
  @@index([eventType, timestamp])
  @@map("security_audit_logs")
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  walletHash  String?
  eventName   String
  visitorId   String?
  sessionId   String?
  timestamp   DateTime @default(now())
  pageUrl     String?
  referrer    String?
  userAgent   String?
  deviceType  String?
  country     String?
  metadata    String?

  @@index([walletHash, timestamp])
  @@index([eventName, timestamp])
  @@index([timestamp])
  @@map("analytics_events")
}

model RAGAuditLog {
  id            String   @id @default(cuid())
  walletAddress String?
  operation     RAGOperation
  documentId    String?
  source        String?
  documentSize  Int?
  success       Boolean
  errorMessage  String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([walletAddress, createdAt])
  @@index([createdAt])
  @@index([operation, createdAt])
  @@map("rag_audit_logs")
}

model EncryptedKey {
  id            String   @id @default(cuid())
  walletAddress String
  encryptedKey  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([walletAddress])
  @@map("encrypted_keys")
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum PaymentMethod {
  NONE
  STRIPE
  CRYPTO
}

enum RAGOperation {
  INDEX
  BATCH_INDEX
  DELETE
  QUERY
}

enum SubscriptionTier {
  FREE
  PREMIUM
}

enum SubscriptionPlan {
  FREE
  PRO
  UNLIMITED
}

enum PaymentIntentStatus {
  PENDING
  CONFIRMED
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum SubscriptionBillingPeriod {
  MONTHLY
  YEARLY
}

enum consentsource {
  WEB_COOKIE_BANNER
  MOBILE
  EMAIL_SUBSCRIPTION
  CONTACT_FORM
}

enum consentstatus {
  GRANTED
  WITHDRAWN
}

enum consenttype {
  HEALTH_DATA_PROCESSING
  ANALYTICS
  MARKETING
}