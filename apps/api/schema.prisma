generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model EmailSubscription {
  id               String    @id @default(cuid())
  email            String    @unique
  fullName         String?
  role             String?
  ipHash           String?
  consentGiven     Boolean   @default(false)
  consentTimestamp DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("email_subscriptions")
}

model ContactMessage {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  subject   String
  message   String
  ipHash    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_messages")
}

model EncryptedChat {
  id                  String    @id @default(cuid())
  walletAddress       String    @unique
  didTokenId          String?
  encryptedBlob       String
  encryptedBlobHash   String
  encryptedKey        String?
  encryptedSummaryRef String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  expiresAt           DateTime?
  retentionDays       Int?

  @@index([walletAddress])
  @@index([didTokenId])
  @@index([expiresAt])
  @@map("encrypted_chats")
}

model Subscription {
  id                   String             @id @default(cuid())
  walletAddress        String             @unique
  didTokenId           String?            @unique
  tier                 SubscriptionTier   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  paymentMethod        PaymentMethod      @default(NONE)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  cryptoPaymentTxHash  String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  payments             Payment[]

  @@index([walletAddress])
  @@index([didTokenId])
  @@index([status])
  @@map("subscriptions")
}

model Payment {
  id                    String        @id @default(cuid())
  subscriptionId        String
  walletAddress         String
  didTokenId            String?
  amount                Decimal       @db.Decimal(18, 8)
  currency              String        @default("USD")
  paymentMethod         PaymentMethod
  status                PaymentStatus @default(PENDING)
  stripePaymentIntentId String?
  cryptoTxHash          String?
  cryptoBlockNumber     BigInt?
  metadata              String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  subscription          Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([walletAddress])
  @@index([status])
  @@index([cryptoTxHash])
  @@map("payments")
}

model RAGAuditLog {
  id            String       @id @default(cuid())
  operation     RAGOperation
  walletAddress String?
  documentId    String?
  source        String?
  documentSize  Int?
  success       Boolean
  errorMessage  String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime     @default(now())

  @@index([operation])
  @@index([walletAddress])
  @@index([documentId])
  @@index([source])
  @@index([createdAt])
  @@map("rag_audit_logs")
}

/**
 * Crisis Safety Net - Opt-in PII storage for users who voluntarily
 * provide contact info for crisis follow-up. Auto-purged after 30 days.
 */
model CrisisOptIn {
  id                String    @id @default(cuid())
  walletAddress     String    @unique // Pseudonymous link to user (unique - one per wallet)
  email             String?   // Encrypted at rest via application layer
  fullName          String?   // Encrypted at rest via application layer
  emergencyContact  String?   // Encrypted at rest via application layer
  language          String    // Detected language code (en, zh, hi, etc.)
  consentHash       String    // Hash of consent data for audit/proof
  createdAt         DateTime  @default(now())
  expiresAt         DateTime  // Auto-purge target (created + 30 days)
  lastCrisisTrigger DateTime? // Last time crisis was detected
  triggerCount      Int       @default(0) // Number of crisis detections

  @@index([expiresAt])
  @@map("crisis_opt_in")
}

model SecurityAuditLog {
  id        String   @id @default(cuid())
  eventType String
  actor     String?
  resource  String?
  success   Boolean
  ipAddress String?
  userAgent String?
  details   String?
  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([actor])
  @@index([createdAt])
  @@map("security_audit_logs")
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  eventName  String
  visitorId  String?
  sessionId  String?
  walletHash String?
  timestamp  DateTime @default(now())
  pageUrl    String?
  referrer   String?
  userAgent  String?
  deviceType String?
  country    String?
  metadata   String?

  @@index([eventName])
  @@index([visitorId])
  @@index([timestamp])
  @@index([sessionId])
  @@index([walletHash])
  @@map("analytics_events")
}

enum SubscriptionTier {
  FREE
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE
  TRIALING
}

enum PaymentMethod {
  NONE
  STRIPE
  CRYPTO
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum RAGOperation {
  INDEX
  DELETE
  BATCH_INDEX
}
