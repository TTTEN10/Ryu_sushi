# Copy this file to `.env` in this directory (`apps/web/.env`).
# Vite only reads variables prefixed with VITE_ ; rebuild after changes.

# API Configuration (optional — empty uses same-origin `/api` via Vite proxy in dev)
VITE_API_URL=http://localhost:3001

# WalletConnect — REQUIRED for QR / mobile wallet pairing (browser extensions work without it).
# Create a project at https://cloud.walletconnect.com and paste the Project ID below.
# Same ID can be used as EXPO_PUBLIC_WALLETCONNECT_PROJECT_ID in apps/safepsy-mobile.
# Example: VITE_WALLETCONNECT_PROJECT_ID=391299af5aedd1d51ef83d5e79e1a46d
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here


