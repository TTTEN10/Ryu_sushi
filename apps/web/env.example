# Copy this file to `.env` in this directory (`apps/web/.env`).
# Vite only reads variables prefixed with VITE_ ; rebuild after changes.

# API Configuration (optional — leave unset or empty for same-origin `/api` via Vite dev proxy)
# VITE_API_URL=http://localhost:3001

# DID identity token (Sepolia) — must match `apps/api/deployments/sepolia-latest.json` → DIDIdentityTokenV2.address
# Required for on-chain `encryptedKeyMetadata` + `updateChatReference` in verified chat flows.
# VITE_DID_IDENTITY_TOKEN_ADDRESS=0x103eAd096f898132E138ad228E35296db983A053

# Optional: browser-side RPC for contract reads (defaults to WalletConnect / injected provider chain)
# VITE_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# WalletConnect — REQUIRED for QR / mobile wallet pairing (browser extensions work without it).
# Create a project at https://cloud.walletconnect.com and paste the Project ID below.
# Same ID can be used as EXPO_PUBLIC_WALLETCONNECT_PROJECT_ID in apps/safepsy-mobile.
# Example: VITE_WALLETCONNECT_PROJECT_ID=391299af5aedd1d51ef83d5e79e1a46d
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here


