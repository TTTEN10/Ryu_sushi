# API Configuration — unset: same-origin `/api` via Vite dev proxy (avoids CORS on :5173/:3000)

# Sepolia RPC for browser-side contract reads (wallet provider used when unset)
VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# DID identity token — must match apps/api/deployments/sepolia-latest.json → DIDIdentityTokenV2.address
VITE_DID_IDENTITY_TOKEN_ADDRESS=0x103eAd096f898132E138E132E138E138E138E138

# Sentry — error tracking & session replay (blank = disabled)
VITE_SENTRY_DSN=

# WalletConnect — https://cloud.walletconnect.com (required for QR / mobile wallet pairing)
# Example: VITE_WALLETCONNECT_PROJECT_ID=391299af5aedd1d51ef83d5e79e1a46d
VITE_WALLETCONNECT_PROJECT_ID=391299af5aedd1d51ef83d5e79e1a46d
