# SafePsy Production Environment Configuration
#
# IMPORTANT: Copy this file to .env and fill in your production values
# NEVER commit .env files to version control
#
# Generate secure secrets with:
#   openssl rand -hex 32   # For JWT_SECRET and IP_SALT
#

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
PORT=3001
NODE_ENV=production

# Frontend URL (for CORS - must match your production domain)
FRONTEND_URL=https://safepsy.com

# =============================================================================
# WEB APP BUILD (`apps/web`) — set in CI or hosting env when building the static client
# =============================================================================
# Vite only exposes variables prefixed with VITE_. These must be present at **build** time.
#
# WalletConnect (QR / mobile wallets). Without it, users can still connect via browser extensions.
# Create a project at https://cloud.walletconnect.com (often shared with the mobile app).
# VITE_WALLETCONNECT_PROJECT_ID=
#
# Optional: explicit API origin for the browser client (empty = same-origin `/api`)
# VITE_API_URL=

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Use a strong password and update accordingly
DATABASE_URL="postgresql://safepsy_user:YOUR_STRONG_PASSWORD@localhost:5432/safepsy_prod"

# =============================================================================
# JWT SESSION CONFIGURATION
# =============================================================================
# CRITICAL: Generate a secure random secret (min 32 characters)
# Command: openssl rand -hex 32
JWT_SECRET="REPLACE_WITH_SECURE_RANDOM_32_CHARS"
JWT_EXPIRES_IN=7d

# =============================================================================
# BLOCKCHAIN / DID CONFIGURATION
# =============================================================================
# Ethereum RPC endpoint (get free API key from https://www.alchemy.com/ or https://www.llamarpc.com/)
# Sepolia (for beta/testing): https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
# Mainnet (for production): https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ETH_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# DID Contract Addresses (Sepolia Testnet - deployed)
DID_REGISTRY_ADDRESS=0x8e5F41f2B8B3E28a8966e37181B257f9E2725bA5
DID_OWNERSHIP_ADDRESS=0xac5Ad1482d73d0E09ED3960C02EebF428Ad63722

# Legacy DID Identity Token (for profile data - Sepolia)
DID_IDENTITY_TOKEN_ADDRESS=0x103eAd096f898132E138ad228E35296db983A053

# Backend Signer Private Key (optional - for backend-initiated DID minting)
# WARNING: Keep this secure! Never commit to version control.
# Generate with: cast wallet new (foundry) or use existing wallet
# DID_BACKEND_SIGNER_PRIVATE_KEY=0xYourPrivateKeyHere

# =============================================================================
# AI / CHATBOT CONFIGURATION
# =============================================================================
# Option 1: Scaleway Generative AI API (recommended for MVP)
# Get your API key from: https://console.scaleway.com/iam/api-keys
# Get your Project ID from: https://console.scaleway.com/project
#
# ✅ CONFIGURED: Scaleway API key and project ID set
# Model: mistral-small-3.2-24b-instruct-2506 (Mistral Small 3.2 - optimized for psychotherapy)
# System prompt: Dr. Safe (warm, psychologically-informed, not therapy/diagnosis)
#
# API Endpoint format: https://api.scaleway.ai/{project_id}/v1/chat/completions
# =============================================================================

# Scaleway API Key (IAM API key - required)
SCALEWAY_API_KEY=your-scaleway-api-key-here

# Scaleway Project ID (required - from your Scaleway project URL)
SCALEWAY_PROJECT_ID=5dad0cb7-c16a-4447-9a25-e89bd3448e8a

# Scaleway API Base URL (optional - defaults to correct format if not set)
SCALEWAY_API_BASE_URL=https://api.scaleway.ai/${SCALEWAY_PROJECT_ID}/v1

# AI Model Configuration
# The default model is mistral-small-3.2-24b-instruct-2506 (Mistral Small 3.2)
# This model is optimized for empathetic, psychologically-informed conversations
# Override if needed:
# AI_MODEL=mistral-small-3.2-24b-instruct-2506

# Option 2: Self-hosted vLLM (GPU instance)
# AI_GPU_BASE_URL=http://62.210.238.160:8000

# Fallback chatbot URL (optional)
# AI_CHATBOT_FALLBACK_URL=http://backup-chatbot:8000

# Upstream timeout (milliseconds)
AI_UPSTREAM_TIMEOUT_MS=120000

# =============================================================================
# RAG (RETRIEVAL-AUGMENTED GENERATION) CONFIGURATION
# =============================================================================
# OpenAI API Key (required for RAG embeddings)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Embedding model
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Qdrant vector database
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=your-qdrant-api-key

# =============================================================================
# STORAGE CONFIGURATION (Scaleway Object Storage)
# =============================================================================
SCALEWAY_OBJECT_STORAGE_ENABLED=true
SCALEWAY_BUCKET_NAME=safepsy-chat-summaries
SCALEWAY_REGION=fr-par
SCALEWAY_ACCESS_KEY=your-scaleway-access-key
SCALEWAY_SECRET_KEY=your-scaleway-secret-key

# =============================================================================
# CRYPTO PAYMENT CONFIGURATION
# =============================================================================
# Ethereum address to receive crypto payments
CRYPTO_PAYMENT_CONTRACT_ADDRESS=0x4D32FFBA2A7e090a10789fc094572f61E956f809

# USDT/USDC contract addresses (Ethereum Mainnet)
USDT_CONTRACT_ADDRESS=0xdAC17F958D2ee523a2206206994597C13D831ec7
USDC_CONTRACT_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48

# Crypto prices for PREMIUM tier (30 days)
CRYPTO_PRICE_PREMIUM_ETH=0.005714
CRYPTO_PRICE_PREMIUM_USDT=20.00
CRYPTO_PRICE_PREMIUM_USDC=20.00

# =============================================================================
# PRIVACY & SECURITY
# =============================================================================
# IP hashing for privacy protection (default: OFF for maximum privacy)
IP_HASHING_ENABLED=false

# CRITICAL: Generate secure random salt (min 32 characters)
# Command: openssl rand -hex 32
# IP_SALT=your-secure-random-salt-change-in-production

# Safety middleware
SAFETY_INJECTION_FILTER_ENABLED=true
SAFETY_INJECTION_BLOCK=true
SAFETY_MODERATION_ENABLED=true
SAFETY_MODERATION_BLOCK=false
SAFETY_PII_REDACTION_ENABLED=true
SAFETY_PII_REDACT_LOGS=true
SAFETY_PII_REDACT_RESPONSES=false

# =============================================================================
# RATE LIMITING & QUOTAS
# =============================================================================
CHAT_QUOTA_DAILY_LIMIT=100
CHAT_QUOTA_MONTHLY_LIMIT=1000

# =============================================================================
# EMAIL CONFIGURATION (Optional)
# =============================================================================
ENABLE_CONFIRMATION_EMAIL=false
EMAIL_PROVIDER=stub
EMAIL_FROM_ADDRESS=noreply@safepsy.com

# Google Sheets Integration (for email subscriptions)
GOOGLE_SHEETS_ENABLED=true
GOOGLE_SHEETS_ID=1SgLzzBLluvvgF-k55jVC8Om8JxK6Ookyp-r6KXAL-D0
GOOGLE_SHEETS_TAB_NAME=Subscriptions
GOOGLE_SHEETS_CREDENTIALS=/path/to/safepsy-service-account.json

# =============================================================================
# MONITORING & ANALYTICS (Optional)
# =============================================================================
# PLAUSIBLE_DOMAIN=safepsy.com

# =============================================================================
# DEPLOYMENT CHECKLIST
# =============================================================================
# Before deploying to production, verify:
# [ ] JWT_SECRET is at least 32 characters (generated with openssl rand -hex 32)
# [ ] IP_SALT is at least 32 characters (if IP_HASHING_ENABLED=true)
# [ ] SCALEWAY_API_KEY is set and valid
# [ ] RPC_URL points to a reliable endpoint (Alchemy/Infura recommended)
# [ ] DID contract addresses are correct for your network
# [ ] DATABASE_URL has a strong password
# [ ] FRONTEND_URL matches your production domain
# [ ] VITE_WALLETCONNECT_PROJECT_ID set in the web app build environment (WalletConnect)
# [ ] All crypto payment addresses are correct
# [ ] Security group rules allow SSH from your IP only
# [ ] HTTPS is configured (Caddy handles this automatically)
#
# Test commands:
#   curl https://safepsy.com/api/chat/health
#   curl -H "Authorization: Bearer <token>" https://safepsy.com/api/did/check
