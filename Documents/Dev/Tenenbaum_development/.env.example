# ---------------------------------------------------------------------------
# Backend configuration. Copy to `.env` and fill in to enable real email.
# If SMTP_* are omitted, the server logs emails to the console instead (dev).
# ---------------------------------------------------------------------------

# Port the Express API listens on (Vite proxies /api here in dev).
PORT=3001

# SMTP transport (e.g. Postmark, SendGrid, Mailgun, Gmail app password…)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Addresses used when sending mail.
MAIL_FROM="Tenenbaum Website <no-reply@tenenbaum.example.com>"
MAIL_TO=hello@tenenbaum.example.com

# Frontend: override the API base if the backend is on another origin.
# VITE_API_BASE=https://api.tenenbaum.example.com/api
