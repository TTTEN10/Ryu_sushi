# Caddy configuration for Tenenbaum Development - Production
# Domain: tenenbaum.eu with automatic HTTPS (Let's Encrypt)

tenenbaum.eu {
    root * /site/dist
    file_server

    encode gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    try_files {path} /index.html

    tls {
        email admin@tenenbaum.eu
    }

    log {
        output file /var/log/caddy/access.log format json
    }
    errors {
        output file /var/log/caddy/error.log
    }
}

www.tenenbaum.eu {
    redir https://tenenbaum.eu{uri} permanent
}