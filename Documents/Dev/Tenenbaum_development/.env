# ---------------------------------------------------------------------------
# Tenenbaum Development - Environment Configuration
# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your actual values.
# If SMTP_* are omitted, the server logs emails to console (development mode).
# ---------------------------------------------------------------------------

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Port the Express API listens on (Vite proxies /api here in dev)
PORT=3001

# Node environment (development | production)
NODE_ENV=development

# =============================================================================
# SMTP EMAIL CONFIGURATION
# ---------------------------------------------------------------------------
# Required for sending real emails (contact forms, newsletters)
# Use your SMTP provider credentials (Postmark, SendGrid, Mailgun, etc.)
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# =============================================================================
# EMAIL ADDRESSES
# ---------------------------------------------------------------------------
# MAIL_FROM: Address shown in "From" field for outgoing emails
# MAIL_TO: Destination address for contact form submissions
# =============================================================================
MAIL_FROM="Tenenbaum Website <no-reply@tenenbaum.example.com>"
MAIL_TO=hello@tenenbaum.example.com

# =============================================================================
# FRONTEND CONFIGURATION
# ---------------------------------------------------------------------------
# VITE_API_BASE: Override API base URL if backend is on different origin
# Leave commented in development (uses Vite proxy)
# =============================================================================
# VITE_API_BASE=https://api.tenenbaum.example.com/api

# =============================================================================
# SECURITY (Optional - for production hardening)
# =============================================================================
# SESSION_SECRET=your-secure-random-string-here
# CORS_ORIGIN=https://tenenbaum.example.com
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
