# SafePsy App Stack (Frontend + Backend + Postgres + Caddy)
# Copy to .env and set values. Never commit .env.

# ---------- Database (used by backend) ----------
POSTGRES_USER=safepsy_user
POSTGRES_PASSWORD=change_me_secure_password
POSTGRES_DB=safepsy

# Backend DATABASE_URL (must match Postgres; URL-encode password if it contains special chars)
DATABASE_URL=postgresql://safepsy_user:change_me_secure_password@postgres:5432/safepsy

# ---------- App (backend) ----------
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://polinapsycho.com,https://www.polinapsycho.com

# ---------- LLM: Scaleway Generative API (production default) ----------
# Deploy path: documentation/private documentation/DEPLOY-RUNBOOK.md (./deployment/deploy-live-app.sh)
# Direct path: Python proxy on app host → Scaleway (no FastAPI chatbot VM).
USE_SCALEWAY_DIRECT=1
SCALEWAY_API_KEY=your-generative-api-secret-key
SCALEWAY_PROJECT_ID=5dad0cb7-c16a-4447-9a25-e89bd3448e8a
SCALEWAY_MODEL=mistral-small-3.2-24b-instruct-2506
# SCALEWAY_API_BASE_URL=https://api.scaleway.ai/${SCALEWAY_PROJECT_ID}/v1
AI_UPSTREAM_TIMEOUT_MS=120000
AI_LOCAL_MOCK=0
# Cache non-streaming completions (summaries, etc.) — requires REDIS_URL
AI_RESPONSE_CACHE_TTL=3600
# AI_RESPONSE_CACHE=0

# ---------- Optional: Node API self-hosted upstream (dev / non-prod only) ----------
# AI_GPU_BASE_URL=http://127.0.0.1:8000
# AI_INTERNAL_API_KEY=generate_with_openssl_rand_hex_32

# ---------- Optional ----------
# REDIS_URL=redis://redis:6379/0
# IP_SALT=optional_32_char_salt_for_ip_hashing
# IP_HASHING_ENABLED=false
# PLAUSIBLE_DOMAIN=polinapsycho.com
# ENABLE_CONFIRMATION_EMAIL=false
