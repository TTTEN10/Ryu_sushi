# Ryu Sushi - variables d'environnement de production
# Copier en .env.production depuis la racine du dépôt, puis compléter.
NODE_ENV=production
PORT=3001
CORS_ORIGIN=https://ryusushi.fr

# SMTP - laisser SMTP_USER vide pour désactiver l'envoi d'emails (base SQLite seule)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=hello@ryusushi.fr
ADMIN_EMAIL=ryusushi56@gmail.com

# Rate limiting (POST-only, protects form submissions)
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW=60000
